TRAEFIK_VERSION=v3.3
ELEMENT_VERSION=latest

# Domain Configuration
DOMAIN_ELEMENT=element.domain.eu
DOMAIN_MATRIX=matrix.domain.eu

# Traefik Host Ports
DASHBOARD_PORT=8088
HTTP_PORT=8082
HTTPS_PORT=8443

# Synapse Configuration
SYNAPSE_SERVER_NAME=matrix.domain.eu
SYNAPSE_REPORT_STATS=no
SYNAPSE_PORT=8008

# PostgreSQL Configuration
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_USER=synapse
POSTGRES_DB=synapse

# VoIP / TURN Server Configuration
# Generate a long, random secret for production
TURN_SECRET=ChangeThisToSomethingRandomAndSecure123!
TURN_REALM=matrix.domain.eu
# TURN/TLS uses the certificate at /etc/letsencrypt/live/${DOMAIN_LIVEKIT}/.
# Port 5349/tcp is used because 443/tcp is commonly already owned by nginx/Traefik.

# LiveKit Configuration (Self-Hosted SFU)
DOMAIN_LIVEKIT=livekit.domain.eu
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_LOG_LEVEL=info

# Element Call Standalone (public shareable video links)
DOMAIN_CALL=call.domain.eu

# -----------------------------------------------------------------------------
# Optional Feature Toggles
# -----------------------------------------------------------------------------
# By default, only the core services (Matrix + Element Web) are started.
# Choose ONE of the following to activate additional features:

# Option A: Core Services ONLY (Default)
# COMPOSE_FILE=docker-compose.yml

# Option B: Core Services + Element Call (Audio/Video Conferencing)
# Linux/macOS: uncomment the line below to include LiveKit, the JWT service,
# and Element Call. Validate with: docker compose config --services
# COMPOSE_FILE=docker-compose.yml:element-call/call.yml
#
# Windows PowerShell users may need semicolon syntax in COMPOSE_FILE or explicit
# Compose files instead, depending on the Docker Compose environment:
# docker compose -f docker-compose.yml -f element-call/call.yml up -d
